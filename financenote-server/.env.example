# 服务端口
PORT=3000
WEB_ORIGIN=http://localhost:5173

# 数据库连接 (PostgreSQL + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=financenote

# JWT 安全密钥 (绝不泄露给前端)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# 大模型 API Key 配置 (后端严格隔离，绝不发往前端)
DEEPSEEK_API_KEY=replace-with-provider-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Embedding provider (optional; omitted means keyword retrieval fallback)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# 文件保存路径 (本地磁盘受控目录)
UPLOAD_DIR=./uploads/documents

# 可选：启用 BullMQ 持久化文档解析队列；未配置时使用单进程回退队列
REDIS_URL=redis://localhost:6379
