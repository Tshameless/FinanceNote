# 服务端口
PORT=3000

# 数据库连接 (PostgreSQL + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=financenote

# JWT 安全密钥 (绝不泄露给前端)
JWT_SECRET=FinanceNote_Super_Secret_JWT_Key_2026_Secure
JWT_EXPIRES_IN=7d

# 大模型 API Key 配置 (后端严格隔离，绝不发往前端)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 文件保存路径 (本地磁盘受控目录)
UPLOAD_DIR=./uploads/documents
